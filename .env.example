# EJEMPLO DE URL PARA LA BASE DE DATOS
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA"

# APP CONFIGS
HOST=0.0.0.0
PORT=3000
API_PREFIX="/api/v2"

# CORS
# Para un solo origen
CORS_ORIGIN=https://mi-app.com
# Para múltiples orígenes
# CORS_ORIGIN=https://app1.com,https://app2.com,https://app3.com

# JWT
JWT_SECRET=jwt_secret!
JWT_REFRESH_SECRET=jwt_refresh_secret!

# N8N
N8N_WEBHOOK_EMAIL_URL="http://localhost:5678/webhook/aaaa-bbbb-cccc-dddd-12345678"
N8N_WEBHOOK_PASSWORD_RESET_URL="http://localhost:5678/webhook/eeee-ffff-gggg-hhhh-87654321"
