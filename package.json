{
  "name": "devhub-backend-app",
  "version": "0.2.1",
  "type": "module",
  "description": "API REST del proyecto DevHub",
  "main": "main.js",
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "start:prod": "node dist/main.js",
    "db:migration:run": "node --loader ts-node/esm ./node_modules/typeorm/cli.js migration:run -d src/lib/database/data-source.ts",
    "db:migration:revert": "node --loader ts-node/esm ./node_modules/typeorm/cli.js migration:revert -d src/lib/database/data-source.ts",
    "db:migration:generate": "node --loader ts-node/esm ./node_modules/typeorm/cli.js migration:generate -d src/lib/database/data-source.ts",
    "db:migration:create": "node --loader ts-node/esm ./node_modules/typeorm/cli.js migration:create"
  },
  "keywords": [],
  "author": "Pablo Sierra Lorente",
  "license": "MIT",
  "packageManager": "pnpm@10.27.0",
  "imports": {
    "#src/*": "./dist/*"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.11",
    "@nestjs/core": "^11.1.11",
    "@nestjs/platform-express": "^11.1.11",
    "@nestjs/typeorm": "^11.0.0",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.26"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.11",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.3",
    "prettier": "^3.7.4",
    "ts-node": "^10.9.2",
    "typeorm-ts-node-esm": "^0.3.20",
    "typescript": "^5.9.3"
  },
  "depcheck": {
    "ignoreMatches": [
      "@root/*",
      "@/*",
      "prettier",
      "ts-node",
      "ts-node-dev",
      "tsx"
    ]
  }
}
