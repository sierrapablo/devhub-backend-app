{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    // "ignoreDeprecations": "6.0",
    "lib": ["ES2024"],
    "baseUrl": ".",
    "paths": {
      "#src/*": ["src/*"],
      "#root/*": ["./*"]
    },
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src"]
}
